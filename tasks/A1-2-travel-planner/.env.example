# 복사해서 .env 를 만들고 거기에만 실제 값을 넣는다:  cp .env.example .env
# .env 는 .gitignore로 막혀 있다.

# ── LLM ─────────────────────────────────────────────────────────────
# 주(main). Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 보조(fallback). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── 장소 검색 ────────────────────────────────────────────────────────
# 주(main). Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
# 좌측 '카카오맵' 메뉴에서 활성화 설정을 켜야 한다(끄면 403).
KAKAO_REST_API_KEY=
# 보조(fallback). https://developers.naver.com/apps/#/register (사용 API: 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 선택 ─────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
